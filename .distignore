# Development files excluded from the wordpress.org release zip.
# Patterns without a leading / match anywhere in the tree.
.DS_Store
Thumbs.db
.env
.env.*
*.bak
*.zip
*.log

# Config and tooling (root only).
/.editorconfig
/.eslintrc
/.eslintrc.js
/.eslintrc.json
/eslint.config.js
/eslint.config.mjs
/.gitignore
/.distignore
/.git
/.stylelintrc.json
/.prettierrc
/.prettierrc.js
/.phpunit.cache
/.phpunit.result.cache
/.wp-env.json
/.wp-env.override.json
/.wordpress-org
/composer.json
/composer.lock
/package.json
/package-lock.json
/webpack.config.js
/phpcs.xml.dist
/phpcs.xml
/playwright.config.ts
/playwright.herd.config.ts
/playwright.woo.config.ts
/phpstan.neon
/phpstan-baseline.neon
/phpstan-constants.php
/phpunit.xml.dist
/phpunit.xml
/phpunit-integration.xml.dist
/jest.config.js
/jest.config.ts

# Dependencies and test output.
/node_modules
/vendor
/tests
/test-results

# GitHub, scripts, and contributing (development only).
/.github
/.husky
/.claude
/bin
/CONTRIBUTING.md
/CODE_OF_CONDUCT.md
/SECURITY.md
/README.md
/CHANGELOG.md

