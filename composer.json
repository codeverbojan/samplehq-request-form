{
	"name": "samplehq/request-form",
	"description": "SampleHQ Request Form - Sample request management for WordPress",
	"type": "wordpress-plugin",
	"version": "1.0.0",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "SampleHQ",
			"homepage": "https://samplehq.io"
		}
	],
	"autoload": {
		"psr-4": {
			"SampleHQForm\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SampleHQForm\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^10.7",
		"php-stubs/wordpress-stubs": "^6.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.0",
		"phpstan/phpstan": "^1.0",
		"phpunit/phpunit": "^10.0",
		"squizlabs/php_codesniffer": "^3.7",
		"szepeviktor/phpstan-wordpress": "^1.0",
		"wp-coding-standards/wpcs": "^3.0",
		"wp-phpunit/wp-phpunit": "^6.9",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyze": "phpstan analyze",
		"test": "phpunit --testsuite Unit",
		"test:integration": "phpunit --testsuite Integration",
		"test:coverage": "phpunit --testsuite Unit --coverage-text",
		"test:all": "phpunit",
		"check": [
			"@lint",
			"@analyze",
			"@test"
		],
		"setup-hooks": "echo 'Run npm install to set up Husky hooks.'"
	}
}
