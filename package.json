{
	"name": "samplehq-request-form",
	"version": "1.0.1",
	"description": "SampleHQ Request Form - Sample request management for WordPress",
	"author": "SampleHQ",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js assets/src",
		"lint:js:fix": "wp-scripts lint-js assets/src --fix",
		"lint:css": "wp-scripts lint-style assets/src/**/*.css",
		"lint:css:fix": "wp-scripts lint-style assets/src/**/*.css --fix",
		"format": "wp-scripts format assets/src",
		"test:js": "wp-scripts test-unit-js --passWithNoTests",
		"check": "npm run lint:js && npm run build",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean all",
		"env:reset": "wp-env destroy && wp-env start",
		"env:cli": "wp-env run cli",
		"test:integration": "wp-env run tests-cli -- /var/www/html/wp-content/plugins/samplehq-request-form/vendor/bin/phpunit -c /var/www/html/wp-content/plugins/samplehq-request-form/phpunit-integration.xml.dist",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"plugin-check": "wp-env run cli -- wp plugin check samplehq-request-form",
		"prepare": "husky"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@wordpress/env": "11.5.0",
		"@wordpress/scripts": "32.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.2"
	},
	"lint-staged": {
		"*.php": "vendor/bin/phpcs --no-colors",
		"assets/src/**/*.js": "wp-scripts lint-js",
		"assets/src/**/*.{css,scss}": "wp-scripts lint-style"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"lucide-react": "1.14.0"
	}
}
